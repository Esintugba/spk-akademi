{
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": false,
    "AllowProductionAutoMigrate": false,
    "PostgresMigrationsAssembly": "API.Migrations.Postgres"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://spkakademi.com",
      "https://www.spkakademi.com"
    ]
  },
  "Jwt": {
    "Key": ""
  },
  "AuthCookies": {
    "RefreshTokenCookieName": "__Host-spk-refresh",
    "AntiforgeryCookieName": "__Host-spk-antiforgery",
    "SameSite": "Lax",
    "Secure": true,
    "Path": "/"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": true
  },
  "AllowedHosts": "spkakademi.com;www.spkakademi.com"
}
